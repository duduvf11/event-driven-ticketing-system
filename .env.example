# Application
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DATABASE_URL=postgresql://root:rootpassword@localhost:5432/ticketing_db?schema=public

# Redis Cache & Concurrency
# If using host port mapping: 6380 (or 6379 if default)
REDIS_URL=redis://localhost:6380

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RESERVATION_TTL_MS=900000

# Load Testing (k6)
API_URL=http://localhost:3000
LOAD_TEST_TIER_ID=""